meta {
  name: 15 - List Roles
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/roles
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
}

tests {
  test("lista realm roles", function () {
    const body = res.getBody();

    expect(res.getStatus()).to.equal(200);
    expect(body).to.be.an("array");
    expect(body.some(function (role) {
      return role.id === bru.getVar("role_id");
    })).to.equal(true);
  });
}
