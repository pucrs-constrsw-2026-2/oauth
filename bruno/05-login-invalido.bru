meta {
  name: 05 - Login Invalido
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/login
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  username: {{username}}
  password: senha-incorreta
}

tests {
  test("credenciais invalidas seguem o contrato padrao", function () {
    const body = res.getBody();

    expect(res.getStatus()).to.equal(401);
    expect(res.getHeader("content-type")).to.include("application/json");
    expect(body).to.have.all.keys(
      "error_code",
      "error_description",
      "error_source",
      "error_stack"
    );
    expect(body.error_code).to.equal("OA-401");
    expect(body.error_description).to.be.a("string").and.not.be.empty;
    expect(body.error_source).to.equal("OAuthAPI.Auth");
    expect(body.error_stack).to.be.an("array").that.is.not.empty;
    expect(body.error_stack[0].message).to.be.a("string").and.not.be.empty;
    expect(JSON.stringify(body)).not.to.include("senha-incorreta");
  });
}

docs {
  Teste negativo intencional: a resposta HTTP esperada e 401, portanto o
  teste Bruno deve passar mesmo que a requisicao apareca em vermelho.
}
