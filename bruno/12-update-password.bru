meta {
  name: 12 - Update Password
  type: http
  seq: 12
}

patch {
  url: {{baseUrl}}/users/{{user_id}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Content-Type: application/json
}

body:json {
  {
    "password": "pessoa4-new-password"
  }
}

tests {
  test("altera somente a senha", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.equal("");
  });
}
