meta {
  name: 06 - Refresh Sem Token
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/refresh-token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  refresh_token:
}

tests {
  test("refresh sem token retorna erro de validacao padrao", function () {
    const body = res.getBody();

    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("content-type")).to.include("application/json");
    expect(body).to.have.all.keys(
      "error_code",
      "error_description",
      "error_source",
      "error_stack"
    );
    expect(body.error_code).to.equal("OA-400");
    expect(body.error_description).to.be.a("string").and.not.be.empty;
    expect(body.error_source).to.equal("OAuthAPI");
    expect(body.error_stack).to.be.an("array").that.is.not.empty;
    expect(body.error_stack[0].message).to.be.a("string").and.not.be.empty;
  });
}

docs {
  Teste negativo intencional para confirmar a validacao obrigatoria de
  refresh_token e o formato padrao de erro.
}
