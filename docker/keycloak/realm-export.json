{
  "id": "constrsw",
  "realm": "constrsw",
  "displayName": "Construcao de Software 2026/2",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "rememberMe": true,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "id": "role-admin-realm",
        "name": "administrator",
        "description": "Papel de Administrador",
        "composite": false,
        "clientRole": false
      },
      {
        "id": "role-coordinator-realm",
        "name": "coordinator",
        "description": "Papel de Coordenador",
        "composite": false,
        "clientRole": false
      },
      {
        "id": "role-professor-realm",
        "name": "professor",
        "description": "Papel de Professor",
        "composite": false,
        "clientRole": false
      },
      {
        "id": "role-student-realm",
        "name": "student",
        "description": "Papel de Aluno",
        "composite": false,
        "clientRole": false
      }
    ],
    "client": {
      "oauth": [
        {
          "id": "role-admin-client",
          "name": "administrator",
          "description": "Papel de Administrador no Client OAuth",
          "composite": false,
          "clientRole": true
        },
        {
          "id": "role-coordinator-client",
          "name": "coordinator",
          "description": "Papel de Coordenador no Client OAuth",
          "composite": false,
          "clientRole": true
        },
        {
          "id": "role-professor-client",
          "name": "professor",
          "description": "Papel de Professor no Client OAuth",
          "composite": false,
          "clientRole": true
        },
        {
          "id": "role-student-client",
          "name": "student",
          "description": "Papel de Aluno no Client OAuth",
          "composite": false,
          "clientRole": true
        }
      ]
    }
  },
  "clients": [
    {
      "id": "client-oauth-id",
      "clientId": "oauth",
      "name": "OAuth Microservice API",
      "rootUrl": "http://localhost:8000",
      "baseUrl": "/",
      "surrogateAuthRequired": false,
      "enabled": true,
      "alwaysDisplayInConsole": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "a12345678-secret-mock",
      "redirectUris": [
        "http://localhost:8000/*",
        "http://127.0.0.1:8000/*"
      ],
      "webOrigins": [
        "*"
      ],
      "notBefore": 0,
      "bearerOnly": false,
      "consentRequired": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": true,
      "publicClient": false,
      "frontchannelLogout": false,
      "protocol": "openid-connect",
      "attributes": {
        "access.token.lifespan": "300",
        "client.secret.creation.time": "1700000000"
      },
      "authorizationSettings": {
        "allowRemoteResourceManagement": true,
        "policyEnforcementMode": "ENFORCING",
        "resources": [
          {
            "name": "classes",
            "type": "urn:oauth:resource:classes",
            "ownerManagedAccess": false,
            "uris": ["/classes"]
          },
          {
            "name": "courses",
            "type": "urn:oauth:resource:courses",
            "ownerManagedAccess": false,
            "uris": ["/courses"]
          },
          {
            "name": "lessons",
            "type": "urn:oauth:resource:lessons",
            "ownerManagedAccess": false,
            "uris": ["/lessons"]
          },
          {
            "name": "professors",
            "type": "urn:oauth:resource:professors",
            "ownerManagedAccess": false,
            "uris": ["/professors"]
          },
          {
            "name": "reservations",
            "type": "urn:oauth:resource:reservations",
            "ownerManagedAccess": false,
            "uris": ["/reservations"]
          },
          {
            "name": "resources",
            "type": "urn:oauth:resource:resources",
            "ownerManagedAccess": false,
            "uris": ["/resources"]
          },
          {
            "name": "rooms",
            "type": "urn:oauth:resource:rooms",
            "ownerManagedAccess": false,
            "uris": ["/rooms"]
          },
          {
            "name": "students",
            "type": "urn:oauth:resource:students",
            "ownerManagedAccess": false,
            "uris": ["/students"]
          }
        ],
        "policies": [
          {
            "name": "administrator-policy",
            "description": "Politica para Administradores",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "roles": "[{\"id\":\"role-admin-client\",\"required\":true}]"
            }
          },
          {
            "name": "coordinator-policy",
            "description": "Politica para Coordenadores",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "roles": "[{\"id\":\"role-coordinator-client\",\"required\":true}]"
            }
          },
          {
            "name": "professor-policy",
            "description": "Politica para Professores",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "roles": "[{\"id\":\"role-professor-client\",\"required\":true}]"
            }
          },
          {
            "name": "administrator-permissions",
            "description": "Permissoes do Administrador",
            "type": "resource",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "resources": "[\"resources\",\"rooms\",\"professors\",\"students\"]",
              "applyPolicies": "[\"administrator-policy\"]"
            }
          },
          {
            "name": "coordinator-permissions",
            "description": "Permissoes do Coordenador",
            "type": "resource",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "resources": "[\"courses\",\"classes\"]",
              "applyPolicies": "[\"coordinator-policy\"]"
            }
          },
          {
            "name": "professor-permissions",
            "description": "Permissoes do Professor",
            "type": "resource",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "resources": "[\"lessons\",\"reservations\"]",
              "applyPolicies": "[\"professor-policy\"]"
            }
          }
        ]
      }
    }
  ],
