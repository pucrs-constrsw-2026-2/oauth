# ConstrSW 2026/2 - Grupo 08
# Credenciais de DESENVOLVIMENTO/laboratorio - nao sao segredos de producao.
# Copiar para .env antes de rodar (o .env real NUNCA deve ser commitado).

# Console de administracao do Keycloak (http://localhost:8080)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Realm e client usados pela API "oauth" (ja definidos no
# keycloak/realm-export.json importado pelo container do Keycloak)
KEYCLOAK_REALM=constrsw
KEYCLOAK_CLIENT_ID=oauth
KEYCLOAK_CLIENT_SECRET=oauth-client-secret-dev-grupo08
